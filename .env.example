# AI backend: "claude" (default) or "openai"
AI_BACKEND=claude

# Only required if AI_BACKEND=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Optional: local API server for saving applications
PORT=5000

# Set to false to generate resume/cover letter even for low-suitability jobs (score ≤ 6)
SKIP_LOW_SCORE=true
